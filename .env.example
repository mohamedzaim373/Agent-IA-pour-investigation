# Copier en .env (jamais versionné) et adapter. ENF-05 : secrets hors du code.

# ---------- Modèle de langage (ENF-07) : offline | groq | ollama
LLM_PROVIDER=offline
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Avec docker compose --profile ollama : http://ollama:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=120

# ---------- Sources : simulation (scénarios rejoués) | live (laboratoire)
BACKEND=simulation
WAZUH_INDEXER_URL=https://192.168.56.30:9200
WAZUH_USER=admin
WAZUH_PASSWORD=
WAZUH_VERIFY_TLS=false
MISP_URL=https://192.168.56.40:8443
MISP_KEY=
MISP_VERIFY_TLS=false
VT_API_KEY=
ABUSEIPDB_API_KEY=
TI_CACHE_TTL_S=86400

# ---------- Stockage : SQLite par défaut ; PostgreSQL avec le profil « postgres »
# DB_URL=postgresql+psycopg://investigator:${POSTGRES_PASSWORD}@postgres:5432/investigator
DB_URL=
POSTGRES_PASSWORD=

# ---------- Politique, identités, confidentialité
POLICY_PATH=config/policy.yaml
ANALYSTS_PATH=config/analysts.yaml
# Secret des pseudonymes (GP-08) ; générer avec : python -c "import secrets; print(secrets.token_hex(32))"
PSEUDONYM_SECRET=

# ---------- RAG ATT&CK
EMBEDDER=tfidf
VECTOR_STORE=memory

# ---------- Intégration Wazuh -> API (POST /alerts/wazuh)
WEBHOOK_TOKEN=
WEBHOOK_ANALYST=soc-duty

# ---------- MISP (profil « misp » de docker compose)
MISP_BASE_URL=https://192.168.56.40:8443
MISP_ADMIN_EMAIL=admin@lab.local
MISP_ADMIN_PASSWORD=
MISP_DB_PASSWORD=
MISP_DB_ROOT_PASSWORD=
