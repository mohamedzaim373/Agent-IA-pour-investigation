<!--
  Règles locales Wazuh du laboratoire (/var/ossec/etc/rules/local_rules.xml).
  Elles produisent les alertes qui déclenchent l'agent d'investigation
  (identifiants 100200 à 100230, repris dans les scénarios S1 à S5).
  Les noms de champs suivent le décodeur windows_eventchannel (win.system.*,
  win.eventdata.*). Vérifier avec /var/ossec/bin/wazuh-logtest après installation.
-->
<group name="local,windows,sysmon,ai_investigator,">

  <!-- S1 / S4 : PowerShell lancé avec une commande encodée -->
  <rule id="100200" level="12">
    <if_group>windows</if_group>
    <field name="win.system.providerName">^Microsoft-Windows-Sysmon$</field>
    <field name="win.system.eventID">^1$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s-(e|en|enc|enco|encod\w*)\s+[A-Za-z0-9+/=]{16,}</field>
    <description>PowerShell lancé avec une commande encodée (-EncodedCommand)</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1027.010</id>
    </mitre>
    <group>powershell,</group>
  </rule>

  <!-- S2 : valeur ajoutée sous une clé Run -->
  <rule id="100210" level="10">
    <if_group>windows</if_group>
    <field name="win.system.providerName">^Microsoft-Windows-Sysmon$</field>
    <field name="win.system.eventID">^13$</field>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\CurrentVersion\\Run(Once)?\\</field>
    <description>Valeur ajoutée sous une clé Run du registre (persistance)</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
    <group>registry,</group>
  </rule>

  <!-- S3 : accès suspect à la mémoire de LSASS -->
  <rule id="100220" level="14">
    <if_group>windows</if_group>
    <field name="win.system.providerName">^Microsoft-Windows-Sysmon$</field>
    <field name="win.system.eventID">^10$</field>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)\\lsass\.exe$</field>
    <field name="win.eventdata.grantedAccess" type="pcre2">(?i)^0x(1010|1410|1438|143a|1fffff|1f3fff)$</field>
    <description>Accès suspect à la mémoire de LSASS (vol d'identifiants)</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>credential_access,</group>
  </rule>

  <!-- S5 : téléchargement via certutil -->
  <rule id="100230" level="12">
    <if_group>windows</if_group>
    <field name="win.system.providerName">^Microsoft-Windows-Sysmon$</field>
    <field name="win.system.eventID">^1$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\certutil\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)urlcache|\s-f\s+https?://</field>
    <description>Téléchargement de fichier via certutil (-urlcache)</description>
    <mitre>
      <id>T1105</id>
    </mitre>
    <group>lolbin,</group>
  </rule>

</group>
